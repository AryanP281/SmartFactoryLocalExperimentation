{
  mode: "client",

  connect: {
    endpoints: ["tcp/zenohrouter:7447"]
  },

  scouting: {
    multicast: {
      enabled: false
    }
  },

  qos: {
    publication: [
      {
        key_exprs: ["events/peripheral/**"],

        config: {
          reliability: "reliable",
          congestion_control: "block"
        }
      }
    ]
  }
}