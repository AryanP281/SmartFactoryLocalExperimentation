Vagrant.configure("2") do |config|
    config.vm.box = "bento/ubuntu-24.04"

    config.vm.define "dapr" do |dapr|
        dapr.vm.hostname = "daprruntime"
        dapr.vm.network "private_network", ip: "192.168.56.2"

        dapr.vm.provider "virtualbox" do |vb|
            vb.memory = 1024
            vb.cpus = 1
        end

        dapr.vm.provision "shell", inline: <<-SHELL
            set -e

            apt-get update
            apt-get install -y docker.io docker-compose-v2 chrony
            systemctl enable --now docker
            systemctl enable --now chrony

            chronyc makestep
            chronyc waitsync
            chronyc tracking
            
            mkdir -p /opt/dapr

            cp -r /vagrant/daprRuntime/. /opt/dapr

            cd /opt/dapr
            export RUNTIME_IP=192.168.56.2
            docker compose down
            docker compose up -d
        SHELL
    end

    config.vm.define "collector" do |collector|
        collector.vm.hostname = "collector"
        collector.vm.network "private_network", ip: "192.168.56.11"

        collector.vm.provider "virtualbox" do |vb|
            vb.memory = 1024
            vb.cpus = 1
        end

        collector.vm.provision "shell", inline: <<-SHELL
            set -e

            grep -qxF "192.168.56.2 daprruntime" /etc/hosts || echo "192.168.56.2 daprruntime" >> /etc/hosts

            apt-get update
            apt-get install -y docker.io docker-compose-v2 chrony
            systemctl enable --now docker
            systemctl enable --now chrony

            chronyc makestep
            chronyc waitsync
            chronyc tracking

            mkdir -p /opt/smartfactorycollector/docker
            mkdir -p /opt/smartfactorycollector/dapr

            cp -r /vagrant/collector/. /opt/smartfactorycollector/docker
            cp -r /vagrant/config/dapr/. /opt/smartfactorycollector/dapr

            cd /opt/smartfactorycollector/docker
            docker build -t smartfactorycollector:dapr .
            export APP_ID=smartfactorycollector
            export APP_PORT=8081
            export RUNTIME_IP=192.168.56.2
            export DAPR_VOL=/opt/smartfactorycollector/dapr
            export DAPR_APP_IMG=smartfactorycollector:dapr
            export COLLECTOR_RUN_ID=100
            docker compose down
            docker compose up -d
        SHELL
    end

    config.vm.define "service" do |service|
        service.vm.hostname = "service"
        service.vm.network "private_network", ip: "192.168.56.10"

        service.vm.provider "virtualbox" do |vb|
            vb.memory = 2048
            vb.cpus = 2
        end

        service.vm.provision "shell", inline: <<-SHELL
            set -e

            grep -qxF "192.168.56.2 daprruntime" /etc/hosts || echo "192.168.56.2 daprruntime" >> /etc/hosts

            apt-get update
            apt-get install -y docker.io docker-compose-v2 chrony
            systemctl enable --now docker
            systemctl enable --now chrony

            chronyc makestep
            chronyc waitsync
            chronyc tracking

            mkdir -p /opt/smartfactoryservice/docker
            mkdir -p /opt/smartfactoryservice/dapr

            cp -r /vagrant/service/. /opt/smartfactoryservice/docker
            cp -r /vagrant/config/dapr/. /opt/smartfactoryservice/dapr

            cd /opt/smartfactoryservice/docker
            docker build -t smartfactoryservice:dapr .
            export APP_ID=service-app
            export APP_PORT=6000
            export DAPR_VOL=/opt/smartfactoryservice/dapr
            export RUNTIME_IP=192.168.56.2
            export DAPR_APP_IMG=smartfactoryservice:dapr
            export PUBLISH_START_DELAY=480000
            export PART_ARRIVAl_RATE_PER_SEC=0.25
            docker compose down
            docker compose up -d
        SHELL
    end

    config.vm.define "monitor" do |monitor|
        monitor.vm.hostname = "monitor"
