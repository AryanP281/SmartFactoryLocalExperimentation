            cp -r /vagrant/daprProject/. /opt/smartfactory/docker
            cp -r /vagrant/config/dapr/. /opt/smartfactory/dapr
            
            cd /opt/smartfactory/docker
            docker build -t smartfactory:dapr .
            export APP_ID=monitor
            export APP_PORT=8081
            export DAPR_VOL=/opt/smartfactory/dapr
            export RUNTIME_IP=192.168.56.2
            export SERVICE_IP=192.168.56.10
            export DAPR_APP_IMG=smartfactory:dapr
            export ACTOR_ROLE=monitor
            export ACTOR_ID=monitor-0
            docker compose down
            docker compose up -d

        SHELL
    end

